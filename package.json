{
  "name": "requirements-analyzer",
  "version": "1.0.0",
  "description": "A CLI that analyzes user stories and acceptance criteria for ambiguities, missing edge cases and testability — combining deterministic checks with AI.",
  "type": "module",
  "bin": {
    "reqcheck": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "analyze": "tsx src/cli.ts examples/search-story.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": ["qa", "requirements", "functional-analysis", "shift-left", "ai", "testing"],
  "author": "Gabriele Scano",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
